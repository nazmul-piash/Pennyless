rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidServerTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.email is string && data.email.size() <= 120 &&
             data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 8 &&
             data.monthlyBudget is number && data.monthlyBudget >= 0 && data.monthlyBudget <= 100000000 &&
             data.seededDemoData is bool &&
             isValidServerTimestamp(data.createdAt) &&
             isValidServerTimestamp(data.updatedAt);
    }

    function isValidAccount(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.accountType in ['CREDIT_CARD', 'BANK', 'CASH', 'SAVINGS'] &&
             data.balance is number && data.balance >= -100000000 && data.balance <= 100000000 &&
             data.creditLimit is number && data.creditLimit >= 0 && data.creditLimit <= 100000000 &&
             data.dueDayOfMonth is int && data.dueDayOfMonth >= 0 && data.dueDayOfMonth <= 31 &&
             data.colorHex is string && data.colorHex.size() >= 4 && data.colorHex.size() <= 12 &&
             data.lastFourDigits is string && data.lastFourDigits.size() <= 8 &&
             isValidServerTimestamp(data.createdAt) &&
             isValidServerTimestamp(data.updatedAt);
    }

    function isValidCategory(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 40 &&
             data.txType in ['EXPENSE', 'INCOME'] &&
             data.iconKey is string && data.iconKey.size() >= 1 && data.iconKey.size() <= 40 &&
             data.colorHex is string && data.colorHex.size() >= 4 && data.colorHex.size() <= 12 &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
             isValidServerTimestamp(data.createdAt) &&
             isValidServerTimestamp(data.updatedAt);
    }

    function isValidTransaction(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.txType in ['EXPENSE', 'INCOME', 'TRANSFER'] &&
             data.amount is number && data.amount > 0 && data.amount <= 100000000 &&
             data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 8 &&
             data.dateIso is string && data.dateIso.size() == 10 && data.dateIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.merchant is string && data.merchant.size() <= 80 &&
             data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 50 &&
             data.subcategory is string && data.subcategory.size() <= 50 &&
             data.accountId is string && data.accountId.size() >= 1 && data.accountId.size() <= 128 &&
             data.accountName is string && data.accountName.size() >= 1 && data.accountName.size() <= 60 &&
             data.note is string && data.note.size() <= 200 &&
             data.needsReview is bool &&
             (!('receiptThumbnail' in data) || (data.receiptThumbnail is string && data.receiptThumbnail.size() <= 150000)) &&
             (!('aiConfidence' in data) || (data.aiConfidence is number && data.aiConfidence >= 0 && data.aiConfidence <= 1)) &&
             (!('lineItems' in data) || (data.lineItems is list && data.lineItems.size() <= 50 && (data.lineItems.size() == 0 || data.lineItems[0] is map))) &&
             isValidServerTimestamp(data.createdAt) &&
             isValidServerTimestamp(data.updatedAt);
    }

    function isValidRecurringBill(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 60 &&
             data.amount is number && data.amount > 0 && data.amount <= 100000000 &&
             data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 50 &&
             data.accountId is string && data.accountId.size() >= 1 && data.accountId.size() <= 128 &&
             data.accountName is string && data.accountName.size() >= 1 && data.accountName.size() <= 60 &&
             data.dayOfMonth is int && data.dayOfMonth >= 1 && data.dayOfMonth <= 31 &&
             data.autoPay is bool &&
             (!('lastPaidMonth' in data) || (data.lastPaidMonth is string && data.lastPaidMonth.size() <= 10)) &&
             isValidServerTimestamp(data.createdAt) &&
             isValidServerTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'currency', 'monthlyBudget', 'seededDemoData', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'currency', 'monthlyBudget', 'seededDemoData', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId);
      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'currency', 'monthlyBudget', 'seededDemoData', 'updatedAt']);
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

      match /accounts/{accountId} {
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(accountId);
        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(accountId) &&
                         incoming().keys().hasAll(['userId', 'name', 'accountType', 'balance', 'creditLimit', 'dueDayOfMonth', 'colorHex', 'lastFourDigits', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'accountType', 'balance', 'creditLimit', 'dueDayOfMonth', 'colorHex', 'lastFourDigits', 'createdAt', 'updatedAt']) &&
                         isValidAccount(incoming(), userId);
        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(accountId) &&
                         isValidAccount(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'accountType', 'balance', 'creditLimit', 'dueDayOfMonth', 'colorHex', 'lastFourDigits', 'updatedAt']);
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(accountId);
      }

      match /categories/{categoryId} {
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(categoryId);
        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(categoryId) &&
                         incoming().keys().hasAll(['userId', 'name', 'txType', 'iconKey', 'colorHex', 'sortOrder', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'txType', 'iconKey', 'colorHex', 'sortOrder', 'createdAt', 'updatedAt']) &&
                         isValidCategory(incoming(), userId);
        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(categoryId) &&
                         isValidCategory(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'txType', 'iconKey', 'colorHex', 'sortOrder', 'updatedAt']);
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(categoryId);
      }

      match /transactions/{transactionId} {
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(transactionId);
        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(transactionId) &&
                         incoming().keys().hasAll(['userId', 'txType', 'amount', 'currency', 'dateIso', 'merchant', 'categoryName', 'subcategory', 'accountId', 'accountName', 'note', 'needsReview', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'txType', 'amount', 'currency', 'dateIso', 'merchant', 'categoryName', 'subcategory', 'accountId', 'accountName', 'note', 'needsReview', 'receiptThumbnail', 'aiConfidence', 'lineItems', 'createdAt', 'updatedAt']) &&
                         isValidTransaction(incoming(), userId);
        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(transactionId) &&
                         isValidTransaction(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['txType', 'amount', 'currency', 'dateIso', 'merchant', 'categoryName', 'subcategory', 'accountId', 'accountName', 'note', 'needsReview', 'receiptThumbnail', 'aiConfidence', 'lineItems', 'updatedAt']);
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(transactionId);
      }

      match /recurringBills/{billId} {
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(billId);
        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(billId) &&
                         incoming().keys().hasAll(['userId', 'title', 'amount', 'categoryName', 'accountId', 'accountName', 'dayOfMonth', 'autoPay', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'amount', 'categoryName', 'accountId', 'accountName', 'dayOfMonth', 'autoPay', 'lastPaidMonth', 'createdAt', 'updatedAt']) &&
                         isValidRecurringBill(incoming(), userId);
        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(billId) &&
                         isValidRecurringBill(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'categoryName', 'accountId', 'accountName', 'dayOfMonth', 'autoPay', 'lastPaidMonth', 'updatedAt']);
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(billId);
      }
    }
  }
}
